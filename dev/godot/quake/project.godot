config_version=5
[application]
config/name="Naraku — 大地割り VFX"
run/main_scene="res://quake.tscn"
[display]
window/size/viewport_width=400
window/size/viewport_height=400
window/size/window_width_override=400
window/size/window_height_override=400
[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0,0,0,0)
